APP_NAME=Navesta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=navesta
DB_USERNAME=navesta
DB_PASSWORD=
HASH_VERIFY=false
SANCTUM_TOKEN_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Payment reminders: "log" (development) or "twilio"
MESSAGING_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
REMINDER_DAYS_BEFORE_DUE=3

# Statements: disk "statements" (local) or "statements_s3"; scanner "none" (dev only) or "clamav"
STATEMENTS_DISK=statements
STATEMENT_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
STATEMENTS_S3_KEY=
STATEMENTS_S3_SECRET=
STATEMENTS_S3_REGION=ap-south-1
STATEMENTS_S3_BUCKET=
STATEMENTS_S3_ENDPOINT=

# Blog images
MEDIA_DISK=public

# Error tracking (inactive when empty)
SENTRY_LARAVEL_DSN=

# Backups (spatie/laravel-backup). DB_DUMP_BINARY_PATH = folder containing pg_dump/psql if not on PATH
DB_DUMP_BINARY_PATH=
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Website sign-in uses a session cookie for these origins (host:port, comma separated)
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_SAME_SITE=lax

# Scaling and security
API_RATE_LIMIT=100
TRUSTED_PROXIES=127.0.0.1
OCTANE_SERVER=frankenphp
# Optional Postgres read replica host(s), comma separated
DB_READ_HOST=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Data protection: notice versions recorded with each consent, and retention periods
NOTICE_VERSION_TERMS=2026-10
NOTICE_VERSION_PRIVACY=2026-10
NOTICE_VERSION_REMINDERS=2026-10
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_STATEMENT_DAYS=365
